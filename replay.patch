+        Text(value.toString(), color = Color.White, fontSize = 30.sp, fontWeight = FontWeight.ExtraBold)
+        Text(label, color = Color.White.copy(alpha = 0.55f), fontSize = 12.sp, letterSpacing = 1.sp)
+    }
+}
+
+@Composable
+private fun ActionRow(icon: ImageVector, label: String, onClick: () -> Unit) {
+    Row(
+        Modifier
+            .padding(horizontal = GUTTER.dp, vertical = 22.dp)
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(16.dp))
+            .background(Color.White.copy(alpha = 0.12f))
+            .clickable(onClick = onClick)
+            .padding(horizontal = 18.dp, vertical = 16.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Icon(icon, contentDescription = null, tint = Color.White, modifier = Modifier.size(20.dp))
+        Spacer(Modifier.width(14.dp))
+        Text(label, color = Color.White, fontSize = 17.sp, fontWeight = FontWeight.SemiBold, modifier = Modifier.weight(1f))
+        Icon(
+            Icons.AutoMirrored.Filled.KeyboardArrowRight,
+            contentDescription = null,
+            tint = Color.White.copy(alpha = 0.5f),
+            modifier = Modifier.size(20.dp),
+        )
+    }
+}
+
+@Composable
+private fun EmptyReplay() {
+    Column(
+        Modifier.fillMaxWidth().padding(horizontal = 36.dp, vertical = 56.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Text(
+            "Not enough listening yet",
+            color = Color.White,
+            fontSize = 22.sp,
+            fontWeight = FontWeight.Bold,
+            textAlign = TextAlign.Center,
+        )
+        Spacer(Modifier.height(8.dp))
+        Text(
+            "Play some songs and your Replay for this period will show up here.",
+            color = Color.White.copy(alpha = 0.6f),
+            fontSize = 15.sp,
+            textAlign = TextAlign.Center,
+        )
+    }
+}
+
+// ── Formatting ──────────────────────────────────────────────────────────────
+
+private fun formatMinutes(ms: Long): String {
+    val minutes = max(1L, (ms / 60_000.0).roundToLong())
+    return if (minutes >= 60) {
+        val h = minutes / 60
+        val m = minutes % 60
+        if (m == 0L) "$h hr" else "$h hr $m min"
+    } else {
+        "$minutes min"
+    }
+}
+
+private fun shareText(summary: ReplaySummary, period: ReplayPeriod): String = buildString {
+    val minutes = max(1L, (summary.totalMs / 60_000.0).roundToLong())
+    append("My LastWave Replay (${period.caption.lowercase()}): $minutes minutes, ${summary.totalPlays} plays.")
+    summary.songs.firstOrNull()?.let { append("\nTop song: ${it.title}${it.subtitle?.let { a -> " – $a" } ?: ""}") }
+    summary.artists.firstOrNull()?.let { append("\nTop artist: ${it.title}") }
+    summary.albums.firstOrNull()?.let { append("\nTop album: ${it.title}") }
+}
