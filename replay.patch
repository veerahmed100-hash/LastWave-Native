+import com.lastwave.app.data.repository.ReplayPeriod
+import com.lastwave.app.data.repository.ReplayRow
+import com.lastwave.app.data.repository.ReplaySummary
+
+private const val STORY_MS = 6500
+
+private enum class StoryPage(val tint: Color) {
+    INTRO(Color(0xFF3B2A63)),
+    MINUTES(Color(0xFF4A3F3B)),
+    ARTIST(Color(0xFF2E4A24)),
+    SONG(Color(0xFF4A3526)),
+    ALBUM(Color(0xFF2D4F2B)),
+    GENRES(Color(0xFF1F2A68)),
+    EXPLORED(Color(0xFF7A0F14)),
+    SUMMARY(Color(0xFF8A1450)),
+}
+
+/**
+ * Full-screen "Play your Replay" story for [summary], which already holds the
+ * numbers for the selected [period] (week, month, year or all time).
+ * Tap the right side for the next card, the left side to go back.
+ */
+@Composable
+fun ReplayStories(
+    summary: ReplaySummary,
+    period: ReplayPeriod,
+    paused: Boolean,
+    onClose: () -> Unit,
+    onShare: () -> Unit,
+) {
+    BackHandler(onBack = onClose)
+
+    val pages = remember(summary) {
+        buildList {
+            add(StoryPage.INTRO)
+            add(StoryPage.MINUTES)
+            if (summary.artists.isNotEmpty()) add(StoryPage.ARTIST)
+            if (summary.songs.isNotEmpty()) add(StoryPage.SONG)
+            if (summary.albums.isNotEmpty()) add(StoryPage.ALBUM)
+            if (summary.genres.isNotEmpty()) add(StoryPage.GENRES)
+            add(StoryPage.EXPLORED)
+            add(StoryPage.SUMMARY)
+        }
+    }
+    var index by remember { mutableIntStateOf(0) }
+    val progress = remember { Animatable(0f) }
+    val last = pages.lastIndex
+
+    LaunchedEffect(index, paused) {
+        if (paused) return@LaunchedEffect
+        progress.snapTo(0f)
+        progress.animateTo(1f, tween(STORY_MS, easing = LinearEasing))
+        if (index < last) index++ else onClose()
+    }
+
+    val page = pages[index.coerceIn(0, last)]
+
+    Box(
+        Modifier
+            .fillMaxSize()
+            .background(Brush.verticalGradient(listOf(page.tint, Color(0xFF0B0A0E))))
+            .pointerInput(Unit) {
+                detectTapGestures { offset ->
+                    if (offset.x < size.width / 3f) {
+                        if (index > 0) index--
+                    } else {
+                        if (index < last) index++ else onClose()
+                    }
+                }
+            },
+    ) {
+        Column(
+            Modifier
+                .fillMaxSize()
+                .windowInsetsPadding(WindowInsets.safeDrawing)
+                .padding(horizontal = 20.dp),
+        ) {
+            Spacer(Modifier.height(10.dp))
+            ProgressBars(count = pages.size, current = index, fraction = progress.value)
+            Spacer(Modifier.height(10.dp))
+            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+                Text(
+                    replayLabel(period),
+                    color = Color.White,
+                    fontSize = 15.sp,
+                    fontWeight = FontWeight.Bold,
+                    modifier = Modifier.weight(1f),
+                )
+                Icon(
+                    Icons.Filled.GraphicEq,
+                    contentDescription = null,
+                    tint = Color.White,
+                    modifier = Modifier.size(18.dp),
+                )
+                Spacer(Modifier.width(6.dp))
+                Text("LastWave", color = Color.White, fontSize = 15.sp, fontWeight = FontWeight.Bold)
+            }
+            Spacer(Modifier.height(22.dp))
+
+            when (page) {
+                StoryPage.INTRO -> IntroPage(summary)
+                StoryPage.MINUTES -> MinutesPage(summary)
+                StoryPage.ARTIST -> FeaturePage(
+                    title = { StoryTitle(allSpan(period) + ", ", "One artist", " kept coming back.") },
+                    rows = summary.artists,
+                    circular = true,
+                    subtitleOf = { "${formatMinutes(it.ms)} · ${plural(it.plays, "Play")}" },
+                )
+                StoryPage.SONG -> FeaturePage(
+                    title = {
+                        StoryTitle(
+                            "In total, ",
+                            plural(summary.distinctSongs, "song"),
+                            " filled your ${fillSpan(period)}.",
+                        )
+                    },
+                    rows = summary.songs,
+                    circular = false,
+                    subtitleOf = {
+                        listOfNotNull(it.subtitle, "${formatMinutes(it.ms)} · ${plural(it.plays, "Play")}")
+                            .joinToString("\n")
+                    },
+                )
+                StoryPage.ALBUM -> FeaturePage(
+                    title = { StoryTitle("This time, ", "One album", " held your attention.") },
+                    rows = summary.albums,
+                    circular = false,
+                    subtitleOf = {
+                        listOfNotNull(it.subtitle, "${formatMinutes(it.ms)} · ${plural(it.plays, "Play")}")
+                            .joinToString("\n")
+                    },
+                )
+                StoryPage.GENRES -> GenresPage(summary)
+                StoryPage.EXPLORED -> ExploredPage(summary)
+                StoryPage.SUMMARY -> SummaryPage(summary, period)
+            }
+        }
+
+        // Close and share sit on top of the tap area so they don't flip pages.
+        Box(
+            Modifier
+                .windowInsetsPadding(WindowInsets.safeDrawing)
+                .align(Alignment.TopEnd)
+                .padding(top = 40.dp, end = 8.dp)
+                .size(44.dp)
+                .clip(CircleShape)
+                .clickable(onClick = onClose),
+            contentAlignment = Alignment.Center,
+        ) {
+            Icon(Icons.Filled.Close, contentDescription = "Close", tint = Color.White)
+        }
+        Box(
+            Modifier
+                .align(Alignment.BottomEnd)
+                .windowInsetsPadding(WindowInsets.safeDrawing)
+                .padding(end = 20.dp, bottom = 16.dp)
+                .size(48.dp)
+                .clip(CircleShape)
+                .background(Color.White.copy(alpha = 0.18f))
+                .clickable(onClick = onShare),
+            contentAlignment = Alignment.Center,
+        ) {
+            Icon(Icons.Filled.Share, contentDescription = "Share", tint = Color.White)
+        }
