+                    Text(
+                        HOLDER,
+                        color = Color.White.copy(alpha = 0.9f),
+                        fontFamily = FontFamily.Monospace,
+                        fontWeight = FontWeight.Bold,
+                        fontSize = 15.sp,
+                        letterSpacing = 2.sp,
+                        maxLines = 1,
+                    )
+                    Text(
+                        card.detail,
+                        color = Color.White.copy(alpha = 0.55f),
+                        fontSize = 12.sp,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                }
+                if (memberSince != null) {
+                    Column(horizontalAlignment = Alignment.End) {
+                        Text(
+                            "MEMBER SINCE",
+                            color = Color.White.copy(alpha = 0.55f),
+                            fontSize = 8.sp,
+                            letterSpacing = 1.sp,
+                        )
+                        Text(
+                            memberSince.replace("/", " / "),
+                            color = Color.White,
+                            fontFamily = FontFamily.Monospace,
+                            fontWeight = FontWeight.Bold,
+                            fontSize = 18.sp,
+                            letterSpacing = 2.sp,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+// ── Charts ──────────────────────────────────────────────────────────────────
+
+@Composable
+private fun SectionTitle(text: String) {
+    Text(
+        text,
+        color = Color.White,
+        fontSize = 28.sp,
+        fontWeight = FontWeight.ExtraBold,
+        modifier = Modifier.padding(start = GUTTER.dp, end = GUTTER.dp, top = 22.dp, bottom = 10.dp),
+    )
+}
+
+@Composable
+private fun ChartRow(row: ReplayRow, circular: Boolean) {
+    val shape = if (circular) CircleShape else RoundedCornerShape(6.dp)
+    Row(
+        Modifier.fillMaxWidth().padding(horizontal = GUTTER.dp, vertical = 7.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        RankBadge(row.rank)
+        if (row.artworkUrl != null) {
+            AsyncImage(
+                model = row.artworkUrl,
+                contentDescription = null,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier.size(56.dp).clip(shape),
+            )
+        } else {
+            InitialTile(row.title, Color.White.copy(alpha = 0.14f), shape)
+        }
+        Spacer(Modifier.width(14.dp))
+        RowText(row)
+    }
+}
+
+@Composable
+private fun GenreRow(row: ReplayRow) {
+    Row(
+        Modifier.fillMaxWidth().padding(horizontal = GUTTER.dp, vertical = 7.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        RankBadge(row.rank)
+        InitialTile(row.title, genreColor(row.title), RoundedCornerShape(6.dp))
+        Spacer(Modifier.width(14.dp))
+        RowText(row)
+    }
+}
+
+@Composable
+private fun androidx.compose.foundation.layout.RowScope.RowText(row: ReplayRow) {
+    Column(Modifier.weight(1f)) {
+        Text(
+            row.title,
+            color = Color.White,
+            fontSize = 17.sp,
+            fontWeight = FontWeight.SemiBold,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+        Text(
+            listOfNotNull(row.subtitle, formatMinutes(row.ms)).joinToString(" · "),
+            color = Color.White.copy(alpha = 0.55f),
+            fontSize = 14.sp,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+    }
+    if (row.plays > 0) {
+        Text(row.plays.toString(), color = Color.White.copy(alpha = 0.45f), fontSize = 14.sp)
+    }
+}
+
+@Composable
+private fun RankBadge(rank: Int) {
+    Text(
+        rank.toString(),
+        color = if (rank == 1) ReplayRed else Color.White.copy(alpha = 0.5f),
+        fontSize = 20.sp,
+        fontWeight = FontWeight.Bold,
+        textAlign = TextAlign.Center,
+        modifier = Modifier.width(34.dp),
+    )
+}
+
+@Composable
+private fun InitialTile(title: String, color: Color, shape: androidx.compose.ui.graphics.Shape) {
+    Box(
+        Modifier.size(56.dp).clip(shape).background(color),
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(
+            title.firstOrNull()?.uppercase() ?: "?",
+            color = Color.White,
+            fontSize = 22.sp,
+            fontWeight = FontWeight.Bold,
+        )
+    }
+}
+
+private fun genreColor(name: String): Color {
+    val palette = listOf(
+        Color(0xFF2E9E87), Color(0xFF3563C9), Color(0xFF3FA65A),
+        Color(0xFF8A4FC4), Color(0xFFC9703A), Color(0xFFC94F7A),
+    )
+    return palette[(name.hashCode() and Int.MAX_VALUE) % palette.size]
+}
+
+// ── Tail ────────────────────────────────────────────────────────────────────
+
+@Composable
+private fun Habits(summary: ReplaySummary) {
+    Column(Modifier.padding(horizontal = GUTTER.dp)) {
+        Text(
+            "Your listening pattern",
+            color = Color.White,
+            fontSize = 28.sp,
+            fontWeight = FontWeight.ExtraBold,
+            modifier = Modifier.padding(top = 22.dp, bottom = 12.dp),
+        )
+        Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+            StatTile("Songs", summary.distinctSongs, Modifier.weight(1f))
+            StatTile("Artists", summary.distinctArtists, Modifier.weight(1f))
+            StatTile("Albums", summary.distinctAlbums, Modifier.weight(1f))
+        }
+        summary.peakHourLabel?.let {
+            Text(
+                "You listen most around $it.",
+                color = Color.White.copy(alpha = 0.6f),
+                fontSize = 14.sp,
+                modifier = Modifier.padding(top = 14.dp),
+            )
+        }
+        summary.biggestDayLabel?.let {
+            Text(
+                "Your biggest day was $it with ${formatMinutes(summary.biggestDayMs)} of listening.",
+                color = Color.White.copy(alpha = 0.6f),
+                fontSize = 14.sp,
+                modifier = Modifier.padding(top = 4.dp),
+            )
+        }
+    }
+}
+
+@Composable
+private fun StatTile(label: String, value: Int, modifier: Modifier = Modifier) {
+    Column(
+        modifier
+            .clip(RoundedCornerShape(16.dp))
+            .background(Color.White.copy(alpha = 0.09f))
+            .padding(vertical = 18.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Text(value.toString(), color = Color.White, fontSize = 30.sp, fontWeight = FontWeight.ExtraBold)
+        Text(label, color = Color.White.copy(alpha = 0.55f), fontSize = 12.sp, letterSpacing = 1.sp)
+    }
+}
+
+@Composable
+private fun ActionRow(icon: ImageVector, label: String, topPadding: Int = 22, onClick: () -> Unit) {
+    Row(
+        Modifier
+            .padding(start = GUTTER.dp, end = GUTTER.dp, top = topPadding.dp, bottom = 22.dp)
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(16.dp))
+            .background(Color.White.copy(alpha = 0.12f))
+            .clickable(onClick = onClick)
+            .padding(horizontal = 18.dp, vertical = 16.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Icon(icon, contentDescription = null, tint = Color.White, modifier = Modifier.size(20.dp))
+        Spacer(Modifier.width(14.dp))
+        Text(label, color = Color.White, fontSize = 17.sp, fontWeight = FontWeight.SemiBold, modifier = Modifier.weight(1f))
+        Icon(
+            Icons.AutoMirrored.Filled.KeyboardArrowRight,
+            contentDescription = null,
+            tint = Color.White.copy(alpha = 0.5f),
+            modifier = Modifier.size(20.dp),
+        )
+    }
+}
+
+@Composable
+private fun EmptyReplay() {
+    Column(
+        Modifier.fillMaxWidth().padding(horizontal = 36.dp, vertical = 56.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Text(
+            "Not enough listening yet",
+            color = Color.White,
+            fontSize = 22.sp,
+            fontWeight = FontWeight.Bold,
+            textAlign = TextAlign.Center,
+        )
+        Spacer(Modifier.height(8.dp))
+        Text(
+            "Play some songs and your Replay for this period will show up here.",
+            color = Color.White.copy(alpha = 0.6f),
+            fontSize = 15.sp,
+            textAlign = TextAlign.Center,
+        )
+    }
+}
