diff --git a/app/src/main/java/com/lastwave/app/data/local/db/PlayEventEntity.kt b/app/src/main/java/com/lastwave/app/data/local/db/PlayEventEntity.kt
new file mode 100644
index 0000000..357ca1d
--- /dev/null
+++ b/app/src/main/java/com/lastwave/app/data/local/db/PlayEventEntity.kt
@@ -0,0 +1,144 @@
+package com.lastwave.app.data.local.db
+
+import androidx.room.Dao
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.Insert
+import androidx.room.PrimaryKey
+import androidx.room.Query
+
+/**
+ * One counted play, with the date it happened. This is what makes dated
+ * stats (this week / month / year) possible; [SongPlayStatsEntity] only keeps
+ * running totals per track.
+ *
+ * [genres] holds the resolved tags for the track as a comma separated string
+ * ("indie pop, indie"), or "" when none could be resolved.
+ */
+@Entity(
+    tableName = "play_events",
+    indices = [Index("playedAtMillis"), Index("trackKey")],
+)
+data class PlayEventEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0L,
+    val trackKey: String,
+    val title: String,
+    val artist: String,
+    val album: String? = null,
+    val artworkUrl: String? = null,
+    val genres: String = "",
+    val playedAtMillis: Long,
+    val listenedMs: Long,
+)
+
+data class TrackAgg(
+    val trackKey: String,
+    val title: String,
+    val artist: String,
+    val artworkUrl: String?,
+    val plays: Int,
+    val totalMs: Long,
+)
+
+data class ArtistAgg(
+    val artist: String,
+    val artworkUrl: String?,
+    val plays: Int,
+    val totalMs: Long,
+)
+
+data class AlbumAgg(
+    val album: String,
+    val artist: String,
+    val artworkUrl: String?,
+    val plays: Int,
+    val totalMs: Long,
+)
+
+data class GenreRow(
+    val genres: String,
+    val listenedMs: Long,
+)
+
+@Dao
+interface PlayEventDao {
+    @Insert
+    suspend fun insert(event: PlayEventEntity)
+
+    @Query(
+        """
+        SELECT trackKey, title, artist, MAX(artworkUrl) AS artworkUrl,
+               COUNT(*) AS plays, SUM(listenedMs) AS totalMs
+        FROM play_events
+        WHERE playedAtMillis >= :from AND playedAtMillis < :to
+        GROUP BY trackKey
+        ORDER BY totalMs DESC, plays DESC
+        LIMIT :limit
+        """,
+    )
+    suspend fun topTracks(from: Long, to: Long, limit: Int): List<TrackAgg>
+
+    @Query(
+        """
+        SELECT artist, MAX(artworkUrl) AS artworkUrl,
+               COUNT(*) AS plays, SUM(listenedMs) AS totalMs
+        FROM play_events
+        WHERE playedAtMillis >= :from AND playedAtMillis < :to
+        GROUP BY artist
+        ORDER BY totalMs DESC, plays DESC
+        LIMIT :limit
+        """,
+    )
+    suspend fun topArtists(from: Long, to: Long, limit: Int): List<ArtistAgg>
+
+    @Query(
+        """
+        SELECT album, artist, MAX(artworkUrl) AS artworkUrl,
+               COUNT(*) AS plays, SUM(listenedMs) AS totalMs
+        FROM play_events
+        WHERE playedAtMillis >= :from AND playedAtMillis < :to
+          AND album IS NOT NULL AND album != ''
+        GROUP BY album, artist
+        ORDER BY totalMs DESC, plays DESC
+        LIMIT :limit
+        """,
+    )
+    suspend fun topAlbums(from: Long, to: Long, limit: Int): List<AlbumAgg>
+
+    @Query(
+        """
+        SELECT genres, listenedMs FROM play_events
+        WHERE playedAtMillis >= :from AND playedAtMillis < :to AND genres != ''
+        """,
+    )
+    suspend fun genreRows(from: Long, to: Long): List<GenreRow>
+
+    @Query("SELECT COUNT(*) FROM play_events WHERE playedAtMillis >= :from AND playedAtMillis < :to")
+    suspend fun totalPlays(from: Long, to: Long): Int
+
+    @Query("SELECT COALESCE(SUM(listenedMs), 0) FROM play_events WHERE playedAtMillis >= :from AND playedAtMillis < :to")
+    suspend fun totalListenedMs(from: Long, to: Long): Long
+
+    @Query("SELECT COUNT(DISTINCT trackKey) FROM play_events WHERE playedAtMillis >= :from AND playedAtMillis < :to")
+    suspend fun distinctSongs(from: Long, to: Long): Int
+
+    @Query("SELECT COUNT(DISTINCT artist) FROM play_events WHERE playedAtMillis >= :from AND playedAtMillis < :to")
+    suspend fun distinctArtists(from: Long, to: Long): Int
+
+    @Query(
+        """
+        SELECT COUNT(*) FROM (
+            SELECT DISTINCT album, artist FROM play_events
+            WHERE playedAtMillis >= :from AND playedAtMillis < :to
+              AND album IS NOT NULL AND album != ''
+        )
+        """,
+    )
+    suspend fun distinctAlbums(from: Long, to: Long): Int
+
+    @Query("SELECT MIN(playedAtMillis) FROM play_events")
+    suspend fun firstPlayedAt(): Long?
+
+    @Query("DELETE FROM play_events")
+    suspend fun clearAll()
+}
diff --git a/app/src/main/java/com/lastwave/app/data/repository/ReplayRepository.kt b/app/src/main/java/com/lastwave/app/data/repository/ReplayRepository.kt
new file mode 100644
index 0000000..89e35ce
--- /dev/null
+++ b/app/src/main/java/com/lastwave/app/data/repository/ReplayRepository.kt
@@ -0,0 +1,180 @@
+package com.lastwave.app.data.repository
+
+import com.lastwave.app.data.genre.GenreResolver
+import com.lastwave.app.data.local.db.PlayEventDao
+import com.lastwave.app.data.local.db.PlayEventEntity
+import kotlinx.coroutines.withTimeoutOrNull
+import java.time.DayOfWeek
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import java.time.temporal.TemporalAdjusters
+import java.util.Locale
+import javax.inject.Inject
+import javax.inject.Singleton
+
+enum class ReplayPeriod(val tab: String, val caption: String) {
+    WEEK("Weekly", "This week"),
+    MONTH("Monthly", "This month"),
+    YEAR("Yearly", "This year"),
+    LIFETIME("Lifetime", "All time"),
+}
+
+data class ReplayRow(
+    val key: String,
+    val rank: Int,
+    val title: String,
+    val subtitle: String?,
+    val artworkUrl: String?,
+    val plays: Int,
+    val ms: Long,
+)
+
+data class ReplaySummary(
+    val totalMs: Long,
+    val totalPlays: Int,
+    val songs: List<ReplayRow>,
+    val artists: List<ReplayRow>,
+    val albums: List<ReplayRow>,
+    val genres: List<ReplayRow>,
+    val distinctSongs: Int,
+    val distinctArtists: Int,
+    val distinctAlbums: Int,
+    /** "MM/yy" of the first recorded play, or null if nothing is recorded yet. */
+    val memberSince: String?,
+) {
+    val isEmpty: Boolean get() = totalPlays == 0
+}
+
+/**
+ * Dated listening history for the Replay screen.
+ *
+ * Plays are recorded from [SongPlayStatsRepository.recordListenedMs], which
+ * MusicPlayer already calls whenever a track ends or is skipped. Nothing in
+ * the audio pipeline is touched.
+ */
+@Singleton
+class ReplayRepository @Inject constructor(
+    private val dao: PlayEventDao,
+    private val genreResolver: GenreResolver,
+) {
+    /**
+     * Saves one play if the track was heard long enough: half its length or
+     * 4 minutes, whichever is shorter, and never under 30 seconds (the same
+     * rule Last.fm uses for scrobbles).
+     */
+    suspend fun recordPlay(
+        title: String,
+        artist: String,
+        album: String?,
+        artworkUrl: String?,
+        listenedMs: Long,
+        durationMs: Long?,
+    ) {
+        if (title.isBlank() || artist.isBlank()) return
+        val needed = maxOf(
+            MIN_PLAY_MS,
+            if (durationMs != null && durationMs > 0L) minOf(durationMs / 2, MAX_PLAY_MS) else MIN_PLAY_MS,
+        )
+        if (listenedMs < needed) return
+
+        // Genre lookup uses the network (Last.fm / iTunes). Never let a slow
+        // lookup lose the play: give it a few seconds, then save without it.
+        val genres = withTimeoutOrNull(GENRE_TIMEOUT_MS) {
+            runCatching { genreResolver.resolve(title, artist) }.getOrDefault("")
+        }.orEmpty()
+
+        dao.insert(
+            PlayEventEntity(
+                trackKey = "${title.trim()}|${artist.trim()}".lowercase(),
+                title = title.trim(),
+                artist = artist.trim(),
+                album = album?.trim()?.takeIf { it.isNotEmpty() },
+                artworkUrl = artworkUrl,
+                genres = genres,
+                playedAtMillis = System.currentTimeMillis() - listenedMs,
+                listenedMs = listenedMs,
+            ),
+        )
+    }
+
+    suspend fun summary(period: ReplayPeriod): ReplaySummary {
+        val (from, to) = range(period)
+        val songs = dao.topTracks(from, to, CHART_LENGTH).mapIndexed { i, t ->
+            ReplayRow(t.trackKey, i + 1, t.title, t.artist, t.artworkUrl, t.plays, t.totalMs)
+        }
+        val artists = dao.topArtists(from, to, CHART_LENGTH).mapIndexed { i, a ->
+            ReplayRow(a.artist.lowercase(), i + 1, a.artist, null, a.artworkUrl, a.plays, a.totalMs)
+        }
+        val albums = dao.topAlbums(from, to, CHART_LENGTH).mapIndexed { i, a ->
+            ReplayRow("${a.album}|${a.artist}".lowercase(), i + 1, a.album, a.artist, a.artworkUrl, a.plays, a.totalMs)
+        }
+        val genres = buildGenreRows(from, to)
+        val first = dao.firstPlayedAt()
+        return ReplaySummary(
+            totalMs = dao.totalListenedMs(from, to),
+            totalPlays = dao.totalPlays(from, to),
+            songs = songs,
+            artists = artists,
+            albums = albums,
+            genres = genres,
+            distinctSongs = dao.distinctSongs(from, to),
+            distinctArtists = dao.distinctArtists(from, to),
+            distinctAlbums = dao.distinctAlbums(from, to),
+            memberSince = first?.let { memberSinceLabel(it) },
+        )
+    }
+
+    private suspend fun buildGenreRows(from: Long, to: Long): List<ReplayRow> {
+        val ms = HashMap<String, Long>()
+        val plays = HashMap<String, Int>()
+        for (row in dao.genreRows(from, to)) {
+            row.genres.split(',')
+                .map { it.trim() }
+                .filter { it.isNotEmpty() }
+                .distinct()
+                .forEach { tag ->
+                    val name = displayGenre(tag)
+                    ms[name] = (ms[name] ?: 0L) + row.listenedMs
+                    plays[name] = (plays[name] ?: 0) + 1
+                }
+        }
+        return ms.entries
+            .sortedWith(compareByDescending<Map.Entry<String, Long>> { it.value }.thenBy { it.key })
+            .take(CHART_LENGTH)
+            .mapIndexed { i, e ->
+                ReplayRow(e.key.lowercase(), i + 1, e.key, null, null, plays[e.key] ?: 0, e.value)
+            }
+    }
+
+    private fun displayGenre(tag: String): String =
+        tag.split(' ').filter { it.isNotEmpty() }.joinToString(" ") { word ->
+            word.replaceFirstChar { c -> if (c.isLowerCase()) c.titlecase(Locale.getDefault()) else c.toString() }
+        }
+
+    /** Start (inclusive) and end (exclusive) of the period, in epoch millis. */
+    private fun range(period: ReplayPeriod): Pair<Long, Long> {
+        val zone = ZoneId.systemDefault()
+        val today = LocalDate.now(zone)
+        val start: LocalDate? = when (period) {
+            ReplayPeriod.WEEK -> today.with(TemporalAdjusters.previousOrSame(DayOfWeek.MONDAY))
+            ReplayPeriod.MONTH -> today.withDayOfMonth(1)
+            ReplayPeriod.YEAR -> today.withDayOfYear(1)
+            ReplayPeriod.LIFETIME -> null
+        }
+        val from = start?.atStartOfDay(zone)?.toInstant()?.toEpochMilli() ?: 0L
+        return from to Long.MAX_VALUE
+    }
+
+    private fun memberSinceLabel(firstPlayedAt: Long): String =
+        java.time.Instant.ofEpochMilli(firstPlayedAt)
+            .atZone(ZoneId.systemDefault())
+            .format(DateTimeFormatter.ofPattern("MM/yy"))
+
+    private companion object {
+        const val MIN_PLAY_MS = 30_000L
+        const val MAX_PLAY_MS = 240_000L
+        const val GENRE_TIMEOUT_MS = 8_000L
+        const val CHART_LENGTH = 5
+    }
+}
