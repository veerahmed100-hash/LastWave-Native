@@ -0,0 +1,83 @@
+package com.lastwave.app.ui.replay
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.lastwave.app.data.repository.ReplayPeriod
+import com.lastwave.app.data.repository.ReplayRepository
+import com.lastwave.app.data.repository.ReplaySummary
+import com.lastwave.app.data.repository.ReplaySyncConfig
+import com.lastwave.app.data.repository.ReplaySyncRepository
+import com.lastwave.app.data.repository.ReplaySyncStatus
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+
+data class ReplayUiState(
+    val period: ReplayPeriod = ReplayPeriod.WEEK,
+    val loading: Boolean = true,
+    val summary: ReplaySummary? = null,
+)
+
+@HiltViewModel
+class ReplayViewModel @Inject constructor(
+    private val repository: ReplayRepository,
+    private val syncRepository: ReplaySyncRepository,
+) : ViewModel() {
+
+    val syncStatus: StateFlow<ReplaySyncStatus> = syncRepository.status
+    val syncConfig: StateFlow<ReplaySyncConfig?> = syncRepository.config
+    fun lastSyncMillis(): Long = syncRepository.lastSyncMillis()
+
+    private val _state = MutableStateFlow(ReplayUiState())
+    val state: StateFlow<ReplayUiState> = _state.asStateFlow()
+
+    private var job: Job? = null
+
+    init {
+        load(ReplayPeriod.WEEK)
+        // Pull in plays from the other phone whenever Replay is opened, and
+        // refresh the charts if anything new arrived.
+        viewModelScope.launch { syncRepository.syncIfDue() }
+        viewModelScope.launch {
+            syncRepository.status.collect { status ->
+                if (status is ReplaySyncStatus.Done && status.added > 0) load(_state.value.period)
+            }
+        }
+    }
+
+    /** Returns an error message, or null if the details were saved (and a first sync started). */
+    fun saveSync(repo: String, token: String): String? {
+        val error = syncRepository.saveConfig(repo, token)
+        if (error == null) viewModelScope.launch { syncRepository.syncNow() }
+        return error
+    }
+
+    fun syncNow() {
+        viewModelScope.launch { syncRepository.syncNow() }
+    }
+
+    fun disableSync() = syncRepository.disable()
+
+    fun setPeriod(period: ReplayPeriod) {
+        if (period == _state.value.period && _state.value.summary != null) return
+        load(period)
+    }
+
+    private fun load(period: ReplayPeriod) {
+        _state.update { it.copy(period = period, loading = true) }
+        job?.cancel()
+        job = viewModelScope.launch {
+            val summary = runCatching {
+                withContext(Dispatchers.IO) { repository.summary(period) }
+            }.getOrNull()
+            _state.update { it.copy(loading = false, summary = summary) }
+        }
+    }
+}
