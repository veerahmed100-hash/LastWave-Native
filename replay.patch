+package com.lastwave.app.ui.replay
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import android.graphics.drawable.BitmapDrawable
+import coil.imageLoader
+import coil.request.ImageRequest
+import coil.request.SuccessResult
+import com.lastwave.app.data.repository.ReplayPeriod
+import com.lastwave.app.data.repository.ReplayRow
+import com.lastwave.app.data.repository.ReplaySummary
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.withContext
+import kotlin.math.min
+
+/**
+ * Draws the shareable Replay picture directly onto a 1080 x 1920 bitmap
+ * (the 9:16 size Instagram Stories expect). It is drawn with Android's
+ * Canvas, not by screenshotting the Compose screen, so it looks the same on
+ * every phone.
+ */
+object ReplayPoster {
+    private const val W = 1080
+    private const val H = 1920
+    private const val MARGIN = 72f
+    private const val RED = 0xFFFF2D55.toInt()
+    private const val WHITE = 0xFFFFFFFF.toInt()
+    private const val GREY = 0xFF9A9AA2.toInt()
+
+    suspend fun render(context: Context, summary: ReplaySummary, period: ReplayPeriod): Bitmap =
+        withContext(Dispatchers.IO) {
+            val urls = (summary.songs.take(5) + summary.artists.take(5) + summary.albums.take(3))
+                .mapNotNull { it.artworkUrl }
+                .distinct()
+            val art: Map<String, Bitmap?> = coroutineScope {
+                urls.map { url -> async { url to load(context, url) } }.awaitAll().toMap()
+            }
+            draw(summary, period, art)
+        }
+
+    private suspend fun load(context: Context, url: String): Bitmap? = runCatching {
+        val request = ImageRequest.Builder(context)
+            .data(url)
+            .allowHardware(false)
+            .size(320)
+            .build()
+        ((context.imageLoader.execute(request) as? SuccessResult)?.drawable as? BitmapDrawable)?.bitmap
+    }.getOrNull()
+
+    private fun text(size: Float, bold: Boolean, color: Int, spacing: Float = 0f) =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textSize = size
+            typeface = Typeface.create("sans-serif", if (bold) Typeface.BOLD else Typeface.NORMAL)
+            this.color = color
+            letterSpacing = spacing
+        }
+
+    private fun fit(text: String, paint: Paint, maxWidth: Float): String {
+        if (paint.measureText(text) <= maxWidth) return text
+        val room = maxWidth - paint.measureText("…")
+        val count = paint.breakText(text, true, room, null)
+        return text.take(count).trimEnd() + "…"
+    }
+
+    private fun draw(summary: ReplaySummary, period: ReplayPeriod, art: Map<String, Bitmap?>): Bitmap {
+        val bmp = Bitmap.createBitmap(W, H, Bitmap.Config.ARGB_8888)
+        val c = Canvas(bmp)
+
+        val bg = Paint().apply {
+            shader = LinearGradient(
+                0f, 0f, 0f, H.toFloat(),
+                intArrayOf(0xFF212125.toInt(), 0xFF121217.toInt(), 0xFF07070B.toInt()),
+                floatArrayOf(0f, 0.55f, 1f),
+                Shader.TileMode.CLAMP,
+            )
+        }
+        c.drawRect(0f, 0f, W.toFloat(), H.toFloat(), bg)
+
+        // ── Header ─────────────────────────────────────────────
+        c.drawText(replayLabel(period), MARGIN, 130f, text(66f, true, WHITE))
+        val brand = text(56f, true, WHITE)
+        val brandX = W - MARGIN - brand.measureText("LastWave")
+        c.drawText("LastWave", brandX, 130f, brand)
+        drawWaves(c, brandX - 92f, 84f)
+        val since = summary.memberSince?.let { " · MEMBER SINCE $it" } ?: ""
+        c.drawText("LASTWAVE LISTENER$since", MARGIN, 186f, text(27f, true, GREY, 0.12f))
+
+        // ── Big number ────────────────────────────────────────
+        c.drawText(totalMinutes(summary.totalMs).toString(), MARGIN - 6f, 470f, text(250f, true, WHITE))
+        c.drawText("MINUTES LISTENED", MARGIN, 548f, text(34f, true, 0xFFD0D0D6.toInt(), 0.14f))
+        c.drawText(
+            "${plural(summary.totalPlays, "Play")} · ${plural(summary.distinctSongs, "song")} · " +
+                plural(summary.distinctArtists, "artist"),
+            MARGIN,
+            606f,
+            text(31f, false, GREY),
+        )
+
+        // ── Top songs / top artists ─────────────────────────────
+        val leftX = MARGIN
+        val rightX = 558f
+        val head = text(28f, true, GREY, 0.14f)
+        c.drawText("TOP SONGS", leftX, 700f, head)
+        c.drawText("TOP ARTISTS", rightX, 700f, head)
+        summary.songs.take(5).forEachIndexed { i, row ->
+            chartRow(c, row, leftX, 745f + i * 116f, circle = false, sub = row.subtitle, art = art, textWidth = 318f)
+        }
+        summary.artists.take(5).forEachIndexed { i, row ->
+            chartRow(c, row, rightX, 745f + i * 116f, circle = true, sub = null, art = art, textWidth = 300f)
+        }
+
+        // ── Top albums ──────────────────────────────────────
+        c.drawText("TOP ALBUMS", MARGIN, 1372f, head)
+        val albumXs = floatArrayOf(72f, 440f, 808f)
+        summary.albums.take(3).forEachIndexed { i, row ->
+            val x = albumXs[i]
+            drawArt(c, art[row.artworkUrl], row.title, x, 1410f, 200f, circle = false, radius = 18f)
+            c.drawText(fit(row.title, text(29f, true, WHITE), 300f), x, 1658f, text(29f, true, WHITE))
+            row.subtitle?.let {
+                c.drawText(fit(it, text(25f, false, GREY), 300f), x, 1694f, text(25f, false, GREY))
+            }
+        }
+
+        // ── Top genres ──────────────────────────────────────
+        if (summary.genres.isNotEmpty()) {
+            c.drawText("TOP GENRES", MARGIN, 1768f, head)
+            val pillText = text(31f, true, WHITE)
+            val pillBg = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = 0xFF2D2D31.toInt() }
+            var x = MARGIN
+            for (g in summary.genres.take(4)) {
+                val w = pillText.measureText(g.title) + 56f
+                if (x + w > W - MARGIN) break
+                c.drawRoundRect(RectF(x, 1795f, x + w, 1861f), 33f, 33f, pillBg)
+                c.drawText(g.title, x + 28f, 1838f, pillText)
+                x += w + 16f
+            }
+        }
+
+        c.drawText(
+            "Counted on this device with LastWave",
+            MARGIN,
+            1900f,
+            text(24f, true, 0xFF6F6F76.toInt()),
+        )
+        return bmp
+    }
+
+    private fun chartRow(
+        c: Canvas,
+        row: ReplayRow,
+        x: Float,
+        top: Float,
+        circle: Boolean,
+        sub: String?,
+        art: Map<String, Bitmap?>,
+        textWidth: Float,
+    ) {
+        val rankPaint = text(34f, true, if (row.rank == 1) RED else 0xFF8E8E96.toInt())
+        c.drawText(row.rank.toString(), x, top + 55f, rankPaint)
+        drawArt(c, art[row.artworkUrl], row.title, x + 44f, top, 84f, circle, 8f)
+        val tx = x + 44f + 84f + 20f
+        val titlePaint = text(31f, true, WHITE)
+        val subPaint = text(26f, false, GREY)
+        c.drawText(fit(row.title, titlePaint, textWidth), tx, top + 37f, titlePaint)
+        val line = listOfNotNull(sub, formatMinutes(row.ms)).joinToString(" · ")
+        c.drawText(fit(line, subPaint, textWidth), tx, top + 73f, subPaint)
+    }
+
+    private fun drawArt(
+        c: Canvas,
+        bmp: Bitmap?,
+        label: String,
+        x: Float,
+        y: Float,
+        size: Float,
+        circle: Boolean,
+        radius: Float,
+    ) {
+        val dst = RectF(x, y, x + size, y + size)
+        val path = Path().apply {
+            if (circle) addOval(dst, Path.Direction.CW) else addRoundRect(dst, radius, radius, Path.Direction.CW)
+        }
+        c.save()
+        c.clipPath(path)
+        if (bmp != null) {
+            val s = min(bmp.width, bmp.height)
+            val sx = (bmp.width - s) / 2
+            val sy = (bmp.height - s) / 2
+            c.drawBitmap(bmp, Rect(sx, sy, sx + s, sy + s), dst, Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG))
+        } else {
+            c.drawRect(dst, Paint().apply { color = 0xFF34343A.toInt() })
+            val letter = text(size * 0.4f, true, WHITE)
+            val ch = label.firstOrNull()?.uppercase() ?: "?"
+            c.drawText(ch, x + (size - letter.measureText(ch)) / 2f, y + size * 0.64f, letter)
+        }
+        c.restore()
+    }
+
+    /** Three stacked wave lines, like the LastWave glyph. */
+    private fun drawWaves(c: Canvas, x: Float, y: Float) {
+        val p = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = WHITE
+            style = Paint.Style.STROKE
+            strokeWidth = 6f
+            strokeCap = Paint.Cap.ROUND
+        }
+        for (i in 0..2) {
+            val yy = y + i * 17f
+            val path = Path().apply {
+                moveTo(x, yy + 8f)
+                quadTo(x + 25f, yy - 6f, x + 50f, yy + 8f)
+            }
+            c.drawPath(path, p)
+        }
+    }
+}
