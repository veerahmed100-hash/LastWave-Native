+package com.lastwave.app.data.repository
+
+import android.content.Context
+import android.util.Base64
+import com.lastwave.app.data.local.db.PlayEventDao
+import com.lastwave.app.data.local.db.PlayEventEntity
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import java.io.IOException
+import java.security.MessageDigest
+import java.util.UUID
+import javax.inject.Inject
+import javax.inject.Singleton
+
+data class ReplaySyncConfig(val repo: String, val token: String)
+
+sealed interface ReplaySyncStatus {
+    /** Sync isn't set up. */
+    data object Off : ReplaySyncStatus
+
+    /** Set up, nothing run yet in this session. */
+    data object Ready : ReplaySyncStatus
+
+    data object Syncing : ReplaySyncStatus
+
+    data class Done(val atMillis: Long, val added: Int) : ReplaySyncStatus
+
+    data class Failed(val message: String) : ReplaySyncStatus
+}
+
+@Serializable
+private data class SyncEvent(
+    val k: String,
+    val t: String,
+    val a: String,
+    val al: String? = null,
+    val u: String? = null,
+    val g: String = "",
+    val p: Long,
+    val l: Long,
+)
+
+@Serializable
+private data class SyncFile(
+    val v: Int = 1,
+    val device: String = "",
+    val events: List<SyncEvent> = emptyList(),
+)
+
+@Serializable
+private data class GhEntry(
+    val name: String = "",
+    val sha: String = "",
+    val type: String = "file",
+)
+
+@Serializable
+private data class GhRepo(
+    @SerialName("private") val isPrivate: Boolean = false,
+)
+
+private class SyncException(message: String) : Exception(message)
+
+/**
+ * Keeps Replay history identical on every phone that uses the same private
+ * GitHub repository.
+ *
+ * Each phone writes only its own file, `replay/replay-<deviceId>.json`, so two
+ * phones never overwrite each other. Every sync downloads the other phones'
+ * files, adds plays this phone doesn't have yet (a play is identified by its
+ * track and start time), then uploads this phone's complete list.
+ */
+@Singleton
+class ReplaySyncRepository @Inject constructor(
+    @ApplicationContext private val context: Context,
+    private val dao: PlayEventDao,
+    okHttpClient: OkHttpClient,
+) {
+    private val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    // The shared client has an HTTP cache; sync needs fresh answers every time.
+    private val http: OkHttpClient = okHttpClient.newBuilder().cache(null).build()
+    private val json = Json { ignoreUnknownKeys = true; coerceInputValues = true }
+    private val mutex = Mutex()
+
+    private val _config = MutableStateFlow(readConfig())
+    val config: StateFlow<ReplaySyncConfig?> = _config.asStateFlow()
+
+    private val _status = MutableStateFlow<ReplaySyncStatus>(
+        if (_config.value == null) ReplaySyncStatus.Off else ReplaySyncStatus.Ready,
+    )
+    val status: StateFlow<ReplaySyncStatus> = _status.asStateFlow()
+
+    fun lastSyncMillis(): Long = prefs.getLong(KEY_LAST_OK, 0L)
+
+    /** Returns an error message, or null when the details look valid and were saved. */
+    fun saveConfig(rawRepo: String, rawToken: String): String? {
+        val repo = rawRepo.trim()
+            .removePrefix("https://github.com/")
+            .removePrefix("github.com/")
+            .removeSuffix("/")
+            .removeSuffix(".git")
+        val token = rawToken.trim()
+        if (!REPO_PATTERN.matches(repo)) return "Repository must look like owner/name"
+        if (token.length < 20) return "That token looks too short"
+        prefs.edit()
+            .putString(KEY_REPO, repo)
+            .putString(KEY_TOKEN, token)
+            .remove(KEY_HASH)
+            .apply()
+        clearRemoteMemory()
+        _config.value = ReplaySyncConfig(repo, token)
+        _status.value = ReplaySyncStatus.Ready
+        return null
+    }
+
+    fun disable() {
+        prefs.edit()
+            .remove(KEY_REPO)
+            .remove(KEY_TOKEN)
+            .remove(KEY_HASH)
+            .remove(KEY_LAST_OK)
+            .remove(KEY_LAST_TRY)
+            .apply()
+        clearRemoteMemory()
+        _config.value = null
+        _status.value = ReplaySyncStatus.Off
+    }
+
+    /** Syncs unless one ran recently. Safe to call from anywhere. */
+    suspend fun syncIfDue() {
+        if (_config.value == null) return
+        if (System.currentTimeMillis() - prefs.getLong(KEY_LAST_TRY, 0L) < MIN_INTERVAL_MS) return
+        syncNow(force = false)
+    }
+
+    /** [force] re-downloads every other phone's file even if it hasn't changed. */
+    suspend fun syncNow(force: Boolean = true) {
+        val cfg = _config.value ?: return
+        if (!mutex.tryLock()) return
+        try {
+            _status.value = ReplaySyncStatus.Syncing
+            prefs.edit().putLong(KEY_LAST_TRY, System.currentTimeMillis()).apply()
+            val added = withContext(Dispatchers.IO) { runSync(cfg, force) }
+            val now = System.currentTimeMillis()
+            prefs.edit().putLong(KEY_LAST_OK, now).apply()
+            _status.value = ReplaySyncStatus.Done(now, added)
+        } catch (e: SyncException) {
+            _status.value = ReplaySyncStatus.Failed(e.message ?: "Sync failed")
+        } catch (e: IOException) {
+            _status.value = ReplaySyncStatus.Failed("No connection to GitHub")
+        } catch (e: Exception) {
+            _status.value = ReplaySyncStatus.Failed(e.message ?: "Sync failed")
+        } finally {
+            mutex.unlock()
+        }
+    }
+
+    private suspend fun runSync(cfg: ReplaySyncConfig, force: Boolean): Int {
+        val repoInfo = json.decodeFromString<GhRepo>(call(cfg, "GET", "/repos/${cfg.repo}"))
+        if (!repoInfo.isPrivate) {
+            throw SyncException("That repository is public. Make it private first, so your listening history stays yours.")
+        }
+
+        val listing = listFolder(cfg)
+        val myName = "replay-${deviceId()}.json"
+
+        val knownKeys = dao.keys().mapTo(HashSet()) { "${it.trackKey}|${it.playedAtMillis}" }
+        val incoming = ArrayList<PlayEventEntity>()
+        for (entry in listing) {
+            val name = entry.name
+            if (entry.type != "file" || !name.startsWith("replay-") || !name.endsWith(".json")) continue
+            if (name == myName) continue
+            if (!force && prefs.getString(SHA_PREFIX + name, null) == entry.sha) continue
+            val body = call(cfg, "GET", "/repos/${cfg.repo}/contents/$FOLDER/$name", raw = true)
+            val file = runCatching { json.decodeFromString<SyncFile>(body) }.getOrNull() ?: continue
+            for (e in file.events) {
+                if (knownKeys.add("${e.k}|${e.p}")) {
+                    incoming += PlayEventEntity(
+                        trackKey = e.k,
+                        title = e.t,
+                        artist = e.a,
+                        album = e.al,
+                        artworkUrl = e.u,
+                        genres = e.g,
+                        playedAtMillis = e.p,
+                        listenedMs = e.l,
+                    )
+                }
+            }
+            prefs.edit().putString(SHA_PREFIX + name, entry.sha).apply()
+        }
+        if (incoming.isNotEmpty()) dao.insertAll(incoming)
+
+        // Upload this phone's full list, but only if it changed since last time.
+        val body = json.encodeToString(
+            SyncFile.serializer(),
+            SyncFile(
+                device = deviceId(),
+                events = dao.getAll().map {
+                    SyncEvent(
+                        k = it.trackKey,
+                        t = it.title,
+                        a = it.artist,
+                        al = it.album,
+                        u = it.artworkUrl,
+                        g = it.genres,
+                        p = it.playedAtMillis,
+                        l = it.listenedMs,
+                    )
+                },
+            ),
+        )
+        val hash = sha256(body)
+        val mine = listing.firstOrNull { it.name == myName }
+        if (mine == null || prefs.getString(KEY_HASH, null) != hash) {
+            val payload = buildJsonObject {
+                put("message", "Replay sync from ${deviceId()}")
+                put("content", Base64.encodeToString(body.toByteArray(Charsets.UTF_8), Base64.NO_WRAP))
+                if (mine != null) put("sha", mine.sha)
+            }
+            call(cfg, "PUT", "/repos/${cfg.repo}/contents/$FOLDER/$myName", payload = payload)
+            prefs.edit().putString(KEY_HASH, hash).apply()
+        }
+        return incoming.size
+    }
+
+    private fun listFolder(cfg: ReplaySyncConfig): List<GhEntry> {
+        val body = try {
+            call(cfg, "GET", "/repos/${cfg.repo}/contents/$FOLDER")
+        } catch (e: SyncException) {
+            if (e.message == NOT_FOUND_MARKER) return emptyList() else throw e
+        }
+        return runCatching { json.decodeFromString<List<GhEntry>>(body) }.getOrDefault(emptyList())
+    }
+
+    private fun call(
+        cfg: ReplaySyncConfig,
+        method: String,
+        path: String,
+        raw: Boolean = false,
+        payload: JsonObject? = null,
+    ): String {
+        val builder = Request.Builder()
+            .url("https://api.github.com$path")
+            .header("Authorization", "Bearer ${cfg.token}")
+            .header("Accept", if (raw) "application/vnd.github.raw+json" else "application/vnd.github+json")
+            .header("X-GitHub-Api-Version", "2022-11-28")
+            .header("User-Agent", "LastWave-Replay-Sync")
+            .header("Cache-Control", "no-cache")
+        if (method == "PUT" && payload != null) {
+            builder.put(payload.toString().toRequestBody("application/json".toMediaType()))
+        } else {
+            builder.get()
+        }
+        return http.newCall(builder.build()).execute().use { response ->
+            val text = response.body?.string().orEmpty()
+            if (!response.isSuccessful) {
+                val isFolderLookup = response.code == 404 && path.endsWith("/contents/$FOLDER")
+                throw SyncException(
+                    when {
+                        isFolderLookup -> NOT_FOUND_MARKER
+                        response.code == 401 -> "GitHub rejected the token. Check it hasn't expired."
+                        response.code == 403 || response.code == 429 ->
+                            "GitHub refused the request. The token needs Contents: Read and write, or you hit a rate limit."
+                        response.code == 404 -> "Repository not found, or the token has no access to it."
+                        response.code == 409 || response.code == 422 ->
+                            "Another phone just updated the file. Try Sync now again."
+                        else -> "GitHub error ${response.code}"
+                    },
+                )
+            }
+            text
+        }
+    }
+
+    private fun readConfig(): ReplaySyncConfig? {
+        val repo = prefs.getString(KEY_REPO, null)
+        val token = prefs.getString(KEY_TOKEN, null)
+        return if (!repo.isNullOrBlank() && !token.isNullOrBlank()) ReplaySyncConfig(repo, token) else null
+    }
+
+    private fun deviceId(): String {
+        prefs.getString(KEY_DEVICE, null)?.let { return it }
+        val id = UUID.randomUUID().toString().take(8)
+        prefs.edit().putString(KEY_DEVICE, id).apply()
+        return id
+    }
+
+    private fun clearRemoteMemory() {
+        val editor = prefs.edit()
+        prefs.all.keys.filter { it.startsWith(SHA_PREFIX) }.forEach { editor.remove(it) }
+        editor.apply()
+    }
+
+    private fun sha256(text: String): String =
+        MessageDigest.getInstance("SHA-256")
+            .digest(text.toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it) }
+
+    private companion object {
+        const val PREFS = "replay_sync"
+        const val KEY_REPO = "repo"
+        const val KEY_TOKEN = "token"
+        const val KEY_DEVICE = "device_id"
+        const val KEY_HASH = "own_file_hash"
+        const val KEY_LAST_OK = "last_ok"
+        const val KEY_LAST_TRY = "last_try"
+        const val SHA_PREFIX = "sha_"
+        const val FOLDER = "replay"
+        const val NOT_FOUND_MARKER = "__folder_missing__"
+        const val MIN_INTERVAL_MS = 15 * 60 * 1000L
+        val REPO_PATTERN = Regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
+    }
+}
