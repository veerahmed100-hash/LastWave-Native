+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextAlign
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import androidx.hilt.navigation.compose.hiltViewModel
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import coil.compose.AsyncImage
+import com.lastwave.app.data.repository.ReplayPeriod
+import com.lastwave.app.data.repository.ReplayRow
+import com.lastwave.app.data.repository.ReplaySummary
+import com.lastwave.app.ui.common.safeDrawingBottomPadding
+import com.lastwave.app.ui.player.LocalMiniPlayerScrollClearance
+import kotlin.math.max
+import kotlin.math.roundToLong
+
+private val ReplayRed = Color(0xFFFF2D55)
+private const val HOLDER = "LASTWAVE LISTENER"
+private const val GUTTER = 24
+
+/**
+ * Replay: dated listening stats (top songs, artists, albums, genres) for the
+ * week, month, year or all time. Laid out after BitChord's Replay page.
+ */
+@Composable
+fun ReplayScreen(
+    onBack: () -> Unit,
+    viewModel: ReplayViewModel = hiltViewModel(),
+) {
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    val summary = state.summary
+    val context = LocalContext.current
+
+    Box(
+        Modifier
+            .fillMaxSize()
+            .background(
+                Brush.verticalGradient(
+                    listOf(Color(0xFF2B2236), Color(0xFF15111B), Color(0xFF050407)),
+                ),
+            ),
+    ) {
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = PaddingValues(
+                bottom = LocalMiniPlayerScrollClearance.current + safeDrawingBottomPadding() + 24.dp,
+            ),
+        ) {
+            item(key = "top") {
+                Column(Modifier.windowInsetsPadding(WindowInsets.statusBars)) {
+                    Spacer(Modifier.height(12.dp))
+                    Box(
+                        Modifier
+                            .padding(start = 16.dp)
+                            .size(48.dp)
+                            .clip(CircleShape)
+                            .background(Color.White.copy(alpha = 0.10f))
+                            .clickable(onClick = onBack),
+                        contentAlignment = Alignment.Center,
+                    ) {
+                        Icon(
+                            Icons.AutoMirrored.Filled.ArrowBack,
+                            contentDescription = "Back",
+                            tint = Color.White,
+                        )
+                    }
+                    Spacer(Modifier.height(56.dp))
+                    Column(Modifier.padding(horizontal = GUTTER.dp)) {
+                        Text(
+                            "Replay",
+                            color = Color.White,
+                            fontSize = 44.sp,
+                            fontWeight = FontWeight.ExtraBold,
+                        )
+                        Text(
+                            state.period.caption,
+                            color = Color.White.copy(alpha = 0.6f),
+                            fontSize = 18.sp,
+                        )
+                        Spacer(Modifier.height(14.dp))
+                        PeriodPicker(state.period, viewModel::setPeriod)
+                        Spacer(Modifier.height(18.dp))
+                    }
+                }
+            }
+
+            when {
+                state.loading && summary == null -> item(key = "loading") {
+                    Box(Modifier.fillMaxWidth().padding(64.dp), Alignment.Center) {
+                        CircularProgressIndicator(color = Color.White.copy(alpha = 0.6f))
+                    }
+                }
+                summary == null || summary.isEmpty -> item(key = "empty") { EmptyReplay() }
+                else -> {
+                    item(key = "cards") { CardRow(summary, state.period) }
+                    item(key = "songs-title") { SectionTitle("Top songs") }
+                    items(summary.songs, key = { "song-${it.key}" }) { ChartRow(it, circular = false) }
+                    item(key = "artists-title") { SectionTitle("Top artists") }
+                    items(summary.artists, key = { "artist-${it.key}" }) { ChartRow(it, circular = true) }
+                    item(key = "albums-title") { SectionTitle("Top albums") }
+                    items(summary.albums, key = { "album-${it.key}" }) { ChartRow(it, circular = false) }
+                    if (summary.genres.isNotEmpty()) {
+                        item(key = "genres-title") { SectionTitle("Top genres") }
+                        items(summary.genres, key = { "genre-${it.key}" }) { GenreRow(it) }
+                    }
+                    item(key = "habits") { Habits(summary) }
+                    item(key = "share") {
+                        ActionRow(Icons.Filled.Share, "Share my Replay") {
+                            val send = Intent(Intent.ACTION_SEND).apply {
+                                type = "text/plain"
+                                putExtra(Intent.EXTRA_TEXT, shareText(summary, state.period))
+                            }
+                            context.startActivity(Intent.createChooser(send, "Share my Replay"))
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+// ── Header ──────────────────────────────────────────────────────────────────
+
+@Composable
+private fun PeriodPicker(selected: ReplayPeriod, onSelect: (ReplayPeriod) -> Unit) {
+    Row(
+        Modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(14.dp))
+            .background(Color.White.copy(alpha = 0.10f))
+            .padding(3.dp),
+        horizontalArrangement = Arrangement.spacedBy(2.dp),
+    ) {
+        ReplayPeriod.entries.forEach { period ->
+            val active = period == selected
+            val background by animateColorAsState(
+                if (active) Color.White.copy(alpha = 0.94f) else Color.Transparent,
+                tween(160),
+                label = "periodChip",
+            )
+            Text(
+                text = period.tab,
+                color = if (active) Color.Black else Color.White.copy(alpha = 0.75f),
+                fontSize = 14.sp,
+                fontWeight = FontWeight.Bold,
+                textAlign = TextAlign.Center,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+                modifier = Modifier
+                    .weight(1f)
+                    .clip(RoundedCornerShape(11.dp))
+                    .background(background)
+                    .clickable { onSelect(period) }
+                    .padding(horizontal = 6.dp, vertical = 9.dp),
+            )
+        }
+    }
+}
+
+// ── Cards ───────────────────────────────────────────────────────────────────
+
+private data class HeroCard(val label: String, val value: String, val unit: String, val detail: String)
+
+@Composable
+private fun CardRow(summary: ReplaySummary, period: ReplayPeriod) {
+    val minutes = max(1L, (summary.totalMs / 60_000.0).roundToLong())
+    val plays = if (summary.totalPlays == 1) "1 Play" else "${summary.totalPlays} Plays"
+    val cards = buildList {
+        add(HeroCard("YOUR LISTENING EXPERIENCE", minutes.toString(), "MINUTES LISTENED", "$plays · ${period.caption}"))
+        summary.songs.firstOrNull()?.let {
+            add(HeroCard("YOUR TOP SONG", it.title, "TOP SONG", it.subtitle ?: period.caption))
+        }
+        summary.artists.firstOrNull()?.let {
+            add(HeroCard("YOUR TOP ARTIST", it.title, "TOP ARTIST", period.caption))
+        }
+        summary.albums.firstOrNull()?.let {
+            add(HeroCard("YOUR TOP ALBUM", it.title, "TOP ALBUM", it.subtitle ?: period.caption))
+        }
+    }
+    LazyRow(
+        contentPadding = PaddingValues(horizontal = GUTTER.dp),
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        items(cards, key = { it.label }) { card ->
+            CreditCard(card, summary.memberSince, Modifier.width(300.dp))
+        }
+    }
+    Spacer(Modifier.height(16.dp))
+}
+
+@Composable
+private fun CreditCard(card: HeroCard, memberSince: String?, modifier: Modifier = Modifier) {
+    val shape = RoundedCornerShape(24.dp)
+    Box(
+        modifier
+            .aspectRatio(1.586f)
+            .clip(shape)
+            .background(
+                Brush.linearGradient(listOf(Color(0xFF3B3345), Color(0xFF211B29), Color(0xFF17121D))),
+            ),
+    ) {
+        Column(Modifier.fillMaxSize().padding(20.dp)) {
+            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.Top) {
+                Text(
+                    card.label,
+                    color = Color.White.copy(alpha = 0.7f),
+                    fontSize = 12.sp,
+                    fontWeight = FontWeight.Bold,
+                    letterSpacing = 2.sp,
+                    modifier = Modifier.weight(1f),
+                )
+                Text("≋", color = Color.White, fontSize = 30.sp)
+            }
+            Spacer(Modifier.weight(1f))
+            Text(
+                card.value,
+                color = Color.White,
+                fontSize = if (card.value.length > 10) 24.sp else 40.sp,
+                fontWeight = FontWeight.ExtraBold,
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis,
+            )
+            Text(
+                card.unit,
+                color = Color.White.copy(alpha = 0.75f),
+                fontFamily = FontFamily.Monospace,
+                fontWeight = FontWeight.Bold,
+                fontSize = 13.sp,
+                letterSpacing = 2.sp,
+            )
+            Spacer(Modifier.height(18.dp))
+            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.Bottom) {
+                Column(Modifier.weight(1f)) {
+                    Text(
+                        HOLDER,
+                        color = Color.White.copy(alpha = 0.9f),
+                        fontFamily = FontFamily.Monospace,
+                        fontWeight = FontWeight.Bold,
+                        fontSize = 15.sp,
+                        letterSpacing = 2.sp,
+                        maxLines = 1,
+                    )
+                    Text(
+                        card.detail,
+                        color = Color.White.copy(alpha = 0.55f),
+                        fontSize = 12.sp,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                }
+                if (memberSince != null) {
+                    Column(horizontalAlignment = Alignment.End) {
+                        Text(
+                            "MEMBER SINCE",
+                            color = Color.White.copy(alpha = 0.55f),
+                            fontSize = 8.sp,
+                            letterSpacing = 1.sp,
+                        )
+                        Text(
+                            memberSince.replace("/", " / "),
+                            color = Color.White,
+                            fontFamily = FontFamily.Monospace,
+                            fontWeight = FontWeight.Bold,
+                            fontSize = 18.sp,
+                            letterSpacing = 2.sp,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+// ── Charts ──────────────────────────────────────────────────────────────────
+
+@Composable
+private fun SectionTitle(text: String) {
+    Text(
+        text,
+        color = Color.White,
+        fontSize = 28.sp,
+        fontWeight = FontWeight.ExtraBold,
+        modifier = Modifier.padding(start = GUTTER.dp, end = GUTTER.dp, top = 22.dp, bottom = 10.dp),
+    )
+}
+
+@Composable
+private fun ChartRow(row: ReplayRow, circular: Boolean) {
+    val shape = if (circular) CircleShape else RoundedCornerShape(6.dp)
+    Row(
+        Modifier.fillMaxWidth().padding(horizontal = GUTTER.dp, vertical = 7.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        RankBadge(row.rank)
+        if (row.artworkUrl != null) {
+            AsyncImage(
+                model = row.artworkUrl,
+                contentDescription = null,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier.size(56.dp).clip(shape),
+            )
+        } else {
+            InitialTile(row.title, Color.White.copy(alpha = 0.14f), shape)
+        }
+        Spacer(Modifier.width(14.dp))
+        RowText(row)
+    }
+}
+
+@Composable
+private fun GenreRow(row: ReplayRow) {
+    Row(
+        Modifier.fillMaxWidth().padding(horizontal = GUTTER.dp, vertical = 7.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        RankBadge(row.rank)
+        InitialTile(row.title, genreColor(row.title), RoundedCornerShape(6.dp))
+        Spacer(Modifier.width(14.dp))
+        RowText(row)
+    }
+}
+
+@Composable
+private fun androidx.compose.foundation.layout.RowScope.RowText(row: ReplayRow) {
+    Column(Modifier.weight(1f)) {
+        Text(
+            row.title,
+            color = Color.White,
+            fontSize = 17.sp,
+            fontWeight = FontWeight.SemiBold,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+        Text(
+            listOfNotNull(row.subtitle, formatMinutes(row.ms)).joinToString(" · "),
+            color = Color.White.copy(alpha = 0.55f),
+            fontSize = 14.sp,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+    }
+    if (row.plays > 0) {
+        Text(row.plays.toString(), color = Color.White.copy(alpha = 0.45f), fontSize = 14.sp)
+    }
+}
+
+@Composable
+private fun RankBadge(rank: Int) {
+    Text(
+        rank.toString(),
+        color = if (rank == 1) ReplayRed else Color.White.copy(alpha = 0.5f),
+        fontSize = 20.sp,
+        fontWeight = FontWeight.Bold,
+        textAlign = TextAlign.Center,
+        modifier = Modifier.width(34.dp),
+    )
+}
+
+@Composable
+private fun InitialTile(title: String, color: Color, shape: androidx.compose.ui.graphics.Shape) {
+    Box(
+        Modifier.size(56.dp).clip(shape).background(color),
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(
+            title.firstOrNull()?.uppercase() ?: "?",
+            color = Color.White,
+            fontSize = 22.sp,
+            fontWeight = FontWeight.Bold,
+        )
+    }
+}
+
+private fun genreColor(name: String): Color {
+    val palette = listOf(
+        Color(0xFF2E9E87), Color(0xFF3563C9), Color(0xFF3FA65A),
+        Color(0xFF8A4FC4), Color(0xFFC9703A), Color(0xFFC94F7A),
+    )
+    return palette[(name.hashCode() and Int.MAX_VALUE) % palette.size]
+}
+
+// ── Tail ────────────────────────────────────────────────────────────────────
+
+@Composable
+private fun Habits(summary: ReplaySummary) {
+    Column(Modifier.padding(horizontal = GUTTER.dp)) {
+        Text(
+            "Your listening pattern",
+            color = Color.White,
+            fontSize = 28.sp,
+            fontWeight = FontWeight.ExtraBold,
+            modifier = Modifier.padding(top = 22.dp, bottom = 12.dp),
+        )
+        Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+            StatTile("Songs", summary.distinctSongs, Modifier.weight(1f))
+            StatTile("Artists", summary.distinctArtists, Modifier.weight(1f))
+            StatTile("Albums", summary.distinctAlbums, Modifier.weight(1f))
