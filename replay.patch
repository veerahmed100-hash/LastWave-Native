+package com.lastwave.app.ui.replay
+
+import com.lastwave.app.data.repository.ReplayPeriod
+import java.time.LocalDate
+import java.time.format.TextStyle
+import java.util.Locale
+import kotlin.math.max
+import kotlin.math.roundToLong
+
+/** "3 min", "1 hr 5 min". Anything under a minute still reads "1 min". */
+internal fun formatMinutes(ms: Long): String {
+    val minutes = max(1L, (ms / 60_000.0).roundToLong())
+    return if (minutes >= 60) {
+        val h = minutes / 60
+        val m = minutes % 60
+        if (m == 0L) "$h hr" else "$h hr $m min"
+    } else {
+        "$minutes min"
+    }
+}
+
+internal fun totalMinutes(ms: Long): Long = max(1L, (ms / 60_000.0).roundToLong())
+
+/** Small label in the corner of stories and the poster, e.g. "Replay 26". */
+internal fun replayLabel(period: ReplayPeriod): String {
+    val now = LocalDate.now()
+    val yy = "%02d".format(now.year % 100)
+    return when (period) {
+        ReplayPeriod.WEEK -> "Replay Week"
+        ReplayPeriod.MONTH ->
+            "Replay ${now.month.getDisplayName(TextStyle.SHORT, Locale.getDefault())} $yy"
+        ReplayPeriod.YEAR -> "Replay $yy"
+        ReplayPeriod.LIFETIME -> "Replay All time"
+    }
+}
+
+/** "Your [noun] in music." */
+internal fun periodNoun(period: ReplayPeriod): String {
+    val now = LocalDate.now()
+    return when (period) {
+        ReplayPeriod.WEEK -> "week"
+        ReplayPeriod.MONTH ->
+            "${now.month.getDisplayName(TextStyle.FULL, Locale.getDefault())} ${now.year}"
+        ReplayPeriod.YEAR -> now.year.toString()
+        ReplayPeriod.LIFETIME -> "journey"
+    }
+}
+
+/** "All month, One artist kept coming back." */
+internal fun allSpan(period: ReplayPeriod): String = when (period) {
+    ReplayPeriod.WEEK -> "All week"
+    ReplayPeriod.MONTH -> "All month"
+    ReplayPeriod.YEAR -> "All year"
+    ReplayPeriod.LIFETIME -> "All along"
+}
+
+/** "In total, 10 songs filled your month." */
+internal fun fillSpan(period: ReplayPeriod): String = when (period) {
+    ReplayPeriod.WEEK -> "week"
+    ReplayPeriod.MONTH -> "month"
+    ReplayPeriod.YEAR -> "year"
+    ReplayPeriod.LIFETIME -> "listening history"
+}
+
+internal fun plural(count: Int, one: String, many: String = one + "s"): String =
+    if (count == 1) "1 $one" else "$count $many"
