+import androidx.compose.ui.unit.sp
+import androidx.core.content.FileProvider
+import com.lastwave.app.data.repository.ReplayPeriod
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.time.LocalDate
+
+private const val INSTAGRAM_PACKAGE = "com.instagram.android"
+
+private fun fileName(period: ReplayPeriod): String =
+    "lastwave-replay-${period.name.lowercase()}-${LocalDate.now()}.png"
+
+/** Writes the picture into the cache folder the app's FileProvider already exposes. */
+private fun cacheUri(context: Context, poster: Bitmap, period: ReplayPeriod): Uri {
+    val dir = File(context.cacheDir, "shared").apply { mkdirs() }
+    val file = File(dir, fileName(period))
+    file.outputStream().use { poster.compress(Bitmap.CompressFormat.PNG, 100, it) }
+    return FileProvider.getUriForFile(context, "${context.packageName}.provider", file)
+}
+
+private fun sendIntent(uri: Uri): Intent = Intent(Intent.ACTION_SEND).apply {
+    type = "image/png"
+    putExtra(Intent.EXTRA_STREAM, uri)
+    addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+}
+
+private fun saveToPhotos(context: Context, poster: Bitmap, period: ReplayPeriod): Boolean = runCatching {
+    val values = ContentValues().apply {
+        put(MediaStore.Images.Media.DISPLAY_NAME, fileName(period))
+        put(MediaStore.Images.Media.MIME_TYPE, "image/png")
+        put(MediaStore.Images.Media.RELATIVE_PATH, Environment.DIRECTORY_PICTURES + "/LastWave")
+        put(MediaStore.Images.Media.IS_PENDING, 1)
+    }
+    val resolver = context.contentResolver
+    val uri = resolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, values) ?: return@runCatching false
+    resolver.openOutputStream(uri)?.use { poster.compress(Bitmap.CompressFormat.PNG, 100, it) }
+        ?: return@runCatching false
+    values.clear()
+    values.put(MediaStore.Images.Media.IS_PENDING, 0)
+    resolver.update(uri, values, null, null)
+    true
+}.getOrDefault(false)
+
+/**
+ * Bottom sheet shown after "Share my Replay" or the share button in the
+ * story: previews the picture and offers Share, Instagram and Save to Photos.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ReplayShareSheet(
+    poster: Bitmap,
+    period: ReplayPeriod,
+    onDismiss: () -> Unit,
+) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+
+    ModalBottomSheet(
+        onDismissRequest = onDismiss,
+        containerColor = Color(0xFF1C1C1F),
+        contentColor = Color.White,
+    ) {
+        Column(
+            Modifier
+                .fillMaxWidth()
+                .padding(horizontal = 24.dp)
+                .padding(bottom = 28.dp),
+            horizontalAlignment = Alignment.CenterHorizontally,
+            verticalArrangement = Arrangement.spacedBy(10.dp),
+        ) {
+            Image(
+                bitmap = poster.asImageBitmap(),
+                contentDescription = "Replay picture",
+                modifier = Modifier
+                    .height(340.dp)
+                    .aspectRatio(9f / 16f)
+                    .clip(RoundedCornerShape(16.dp)),
+            )
+            Spacer(Modifier.height(6.dp))
+            SheetButton("Share picture") {
+                scope.launch {
+                    val uri = withContext(Dispatchers.IO) { cacheUri(context, poster, period) }
+                    context.startActivity(
+                        Intent.createChooser(sendIntent(uri), "Share my Replay")
+                            .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION),
+                    )
+                }
+            }
+            SheetButton("Instagram Story") {
+                scope.launch {
+                    val uri = withContext(Dispatchers.IO) { cacheUri(context, poster, period) }
+                    try {
+                        context.startActivity(sendIntent(uri).setPackage(INSTAGRAM_PACKAGE))
+                    } catch (_: ActivityNotFoundException) {
+                        Toast.makeText(context, "Instagram isn't installed", Toast.LENGTH_SHORT).show()
+                    }
+                }
+            }
+            SheetButton("Save to Photos") {
+                scope.launch {
+                    val ok = withContext(Dispatchers.IO) { saveToPhotos(context, poster, period) }
+                    Toast.makeText(
+                        context,
+                        if (ok) "Saved to Pictures/LastWave" else "Couldn't save the picture",
+                        Toast.LENGTH_SHORT,
+                    ).show()
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun SheetButton(label: String, onClick: () -> Unit) {
+    Button(
+        onClick = onClick,
+        modifier = Modifier.fillMaxWidth(),
+        colors = ButtonDefaults.buttonColors(
+            containerColor = Color.White.copy(alpha = 0.12f),
+            contentColor = Color.White,
+        ),
+        shape = RoundedCornerShape(14.dp),
+    ) {
+        Text(label, fontSize = 16.sp, fontWeight = FontWeight.SemiBold, modifier = Modifier.padding(vertical = 4.dp))
+    }
+}
