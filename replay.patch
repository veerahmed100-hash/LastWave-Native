+import androidx.compose.material3.OutlinedTextFieldDefaults
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.input.KeyboardType
+import androidx.compose.ui.text.input.PasswordVisualTransformation
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import com.lastwave.app.data.repository.ReplaySyncConfig
+import com.lastwave.app.data.repository.ReplaySyncStatus
+import java.text.DateFormat
+import java.util.Date
+
+/**
+ * Setup and status for syncing Replay between phones through a private
+ * GitHub repository. Both phones enter the same repository and token.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ReplaySyncSheet(
+    config: ReplaySyncConfig?,
+    status: ReplaySyncStatus,
+    lastSyncMillis: Long,
+    onSave: (repo: String, token: String) -> String?,
+    onSyncNow: () -> Unit,
+    onDisable: () -> Unit,
+    onDismiss: () -> Unit,
+) {
+    var repo by remember { mutableStateOf("") }
+    var token by remember { mutableStateOf("") }
+    var error by remember { mutableStateOf<String?>(null) }
+
+    ModalBottomSheet(
+        onDismissRequest = onDismiss,
+        containerColor = Color(0xFF1C1C1F),
+        contentColor = Color.White,
+    ) {
+        Column(
+            Modifier
+                .fillMaxWidth()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = 24.dp)
+                .padding(bottom = 32.dp),
+            verticalArrangement = Arrangement.spacedBy(10.dp),
+        ) {
+            Text("Sync across devices", fontSize = 22.sp, fontWeight = FontWeight.ExtraBold)
+
+            if (config == null) {
+                Muted(
+                    "Keep one Replay on all your phones. Each phone saves its plays to a private " +
+                        "GitHub repository that only you can open, and reads the other phones' plays from it.",
+                )
+                Muted(
+                    "1. On github.com create a new PRIVATE repository and tick \"Add a README\".\n" +
+                        "2. Go to Settings → Developer settings → Personal access tokens → Fine-grained tokens → " +
+                        "Generate new token. Choose \"Only select repositories\" and pick that one repository. " +
+                        "Under Permissions set Contents to \"Read and write\".\n" +
+                        "3. Enter the repository name and the token below. Use the same two on every phone.",
+                )
+                OutlinedTextField(
+                    value = repo,
+                    onValueChange = { repo = it; error = null },
+                    label = { Text("Repository (owner/name)") },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth(),
+                    colors = fieldColors(),
+                )
+                OutlinedTextField(
+                    value = token,
+                    onValueChange = { token = it; error = null },
+                    label = { Text("Token") },
+                    singleLine = true,
+                    visualTransformation = PasswordVisualTransformation(),
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Password),
+                    modifier = Modifier.fillMaxWidth(),
+                    colors = fieldColors(),
+                )
+                error?.let { Text(it, color = Color(0xFFFF6B6B), fontSize = 14.sp) }
+                Spacer(Modifier.height(4.dp))
+                SyncButton("Save and sync") { error = onSave(repo, token) }
+            } else {
+                Muted("Repository: ${config.repo}")
+                Text(statusLine(status, lastSyncMillis), fontSize = 15.sp)
+                Spacer(Modifier.height(4.dp))
+                SyncButton(
+                    if (status is ReplaySyncStatus.Syncing) "Syncing…" else "Sync now",
+                    enabled = status !is ReplaySyncStatus.Syncing,
+                    onClick = onSyncNow,
+                )
+                TextButton(onClick = onDisable, modifier = Modifier.fillMaxWidth()) {
+                    Text("Turn off sync on this phone", color = Color(0xFFFF8A8A))
+                }
+                Muted(
+                    "Plays already on this phone stay. Your repository and its files aren't deleted. " +
+                        "The phones sync when LastWave opens, about every 30 minutes while it runs, and when you open Replay.",
+                )
+            }
+        }
+    }
+}
+
+private fun statusLine(status: ReplaySyncStatus, lastSyncMillis: Long): String = when (status) {
+    ReplaySyncStatus.Off -> ""
+    ReplaySyncStatus.Syncing -> "Syncing…"
+    is ReplaySyncStatus.Failed -> "Last sync failed: ${status.message}"
+    is ReplaySyncStatus.Done ->
+        "Synced ${time(status.atMillis)}" +
+            if (status.added > 0) ", ${status.added} new plays from your other devices." else ". Everything is up to date."
+    ReplaySyncStatus.Ready ->
+        if (lastSyncMillis > 0L) "Last synced ${time(lastSyncMillis)}." else "Ready. Tap Sync now."
+}
+
+private fun time(millis: Long): String =
+    DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT).format(Date(millis))
+
+@Composable
+private fun Muted(text: String) {
+    Text(text, color = Color.White.copy(alpha = 0.62f), fontSize = 14.sp, lineHeight = 20.sp)
+}
+
+@Composable
+private fun fieldColors() = OutlinedTextFieldDefaults.colors(
+    focusedTextColor = Color.White,
+    unfocusedTextColor = Color.White,
+    focusedLabelColor = Color.White.copy(alpha = 0.8f),
+    unfocusedLabelColor = Color.White.copy(alpha = 0.6f),
+    focusedBorderColor = Color.White.copy(alpha = 0.7f),
+    unfocusedBorderColor = Color.White.copy(alpha = 0.3f),
+    cursorColor = Color.White,
+)
+
+@Composable
+private fun SyncButton(label: String, enabled: Boolean = true, onClick: () -> Unit) {
+    Button(
+        onClick = onClick,
+        enabled = enabled,
+        modifier = Modifier.fillMaxWidth(),
+        colors = ButtonDefaults.buttonColors(
+            containerColor = Color.White,
+            contentColor = Color.Black,
+            disabledContainerColor = Color.White.copy(alpha = 0.25f),
+            disabledContentColor = Color.White.copy(alpha = 0.6f),
+        ),
+        shape = RoundedCornerShape(14.dp),
+    ) {
+        Text(label, fontSize = 16.sp, fontWeight = FontWeight.Bold, modifier = Modifier.padding(vertical = 4.dp))
+    }
+}
